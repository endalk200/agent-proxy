{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "effecttsgo/unstable-api-usage": "off",
    "import/no-unassigned-import": "off",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it", "it.effect", "it.live", "it.flakyTest", "it.prop"]
      }
    ],
    "typescript/consistent-return": "off"
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "e2e/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
