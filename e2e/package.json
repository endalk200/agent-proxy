{
  "name": "@agent-proxy/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Black-box end-to-end tests against the built CLI and web client",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "effect-tsgo oxlint --type-aware",
    "lint:fix": "effect-tsgo oxlint --type-aware --fix",
    "test:e2e": "bun --bun vitest run && playwright test"
  },
  "devDependencies": {
    "@agent-proxy/cli": "workspace:*",
    "@agent-proxy/sandbox": "workspace:*",
    "@agent-proxy/web": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
