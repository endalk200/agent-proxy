{
  "name": "@agent-proxy/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated environments for running agent-proxy, shared by e2e tests and the verify tool",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "effect-tsgo oxlint --type-aware",
    "lint:fix": "effect-tsgo oxlint --type-aware --fix",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@playwright/test": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@agent-proxy/cli": "workspace:*",
    "@agent-proxy/web": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
